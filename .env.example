# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon, Supabase, Railway, or local Postgres all work).
# On Supabase specifically: DATABASE_URL is the pooled (port 6543, pgbouncer=true)
# connection string; DIRECT_URL is the direct/session one (port 5432), used only
# for running migrations. Project -> Connect -> ORMs -> Prisma gives you both.
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/emberwake?schema=public"
DIRECT_URL="postgresql://johndoe:randompassword@localhost:5432/emberwake?schema=public"

# Auth.js / NextAuth
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

